<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>drone_bringup</name>
  <version>0.1.0</version>
  <description>
    Launch package para el sistema de deteccion y mapeo de personas con
    camara termica en dron. Lanza todos los nodos del pipeline con un
    unico comando, permitiendo seleccionar el video a analizar.
  </description>
  <maintainer email="gruzver.phocco@pucp.edu.pe">gr</maintainer>
  <license>TODO: License declaration</license>

  <exec_depend>video_publisher_node</exec_depend>
  <exec_depend>yolo_detection_node</exec_depend>
  <exec_depend>georeferencing_node</exec_depend>
  <exec_depend>map_server_node</exec_depend>
  <exec_depend>drone_tracker_msgs</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
